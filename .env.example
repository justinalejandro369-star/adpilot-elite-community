# ============================================================
# AdPilot Elite — Variables de entorno para Vercel
# ============================================================
# Agrega estas variables en Vercel > Settings > Environment Variables
# ============================================================

# --- AUTENTICACIÓN (requeridas) ---
# Genera NEXTAUTH_SECRET con: openssl rand -base64 32
NEXTAUTH_SECRET=
# URL de tu app en Vercel (sin slash final)
NEXTAUTH_URL=http://localhost:3000
# Credenciales de acceso al dashboard
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# --- FUENTE DE DATOS ---
# "mock" → datos de prueba (sin credenciales extra)
# "sheets" → Google Sheets real (requiere GOOGLE_SERVICE_ACCOUNT_KEY)
DATA_SOURCE=mock
CLIENT_CONFIG_FILE=clients.example.json

# Los portales y el envío de métricas a un proveedor de IA están apagados
# por defecto. Evalúa privacidad y autenticación antes de habilitarlos.
ENABLE_PUBLIC_PORTALS=false
ENABLE_AI_COPILOT=false

# --- GOOGLE SHEETS (requerido si DATA_SOURCE=sheets) ---
# 1. Google Cloud Console → IAM & Admin → Service Accounts
# 2. Crea/usa el Service Account existente de n8n
# 3. Genera clave JSON: Actions → Manage keys → Add key → JSON
# 4. Comparte cada spreadsheet con el email del SA (rol: Viewer)
# 5. Codifica: cat key.json | base64 | tr -d '\n'
GOOGLE_SERVICE_ACCOUNT_KEY=

# --- OPENROUTER API (para el AI Copilot) ---
# Obtén tu key en: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# --- n8n (opcional, integración futura) ---
N8N_API_URL=
N8N_API_KEY=
